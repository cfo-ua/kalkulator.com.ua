{
  "name": "kalkulator.com.ua",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "optimize": "npm run optimize:css && npm run optimize:js && npm run optimize:main",
    "optimize:css": "cleancss assets/css/style.css -o assets/css/style.min.css",
    "optimize:js": "node scripts/optimize-js.js",
    "optimize:main": "terser assets/js/main.js -c -m -o assets/js/main.min.js",
    "build": "bundle exec jekyll build",
    "serve": "bundle exec jekyll serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "calculator",
    "ukraine",
    "performance"
  ],
  "author": "kalkulator.com.ua",
  "license": "ISC",
  "description": "Performance optimization tools for kalkulator.com.ua",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "cssnano": "^7.1.0",
    "postcss-cli": "^11.0.1",
    "terser": "^5.43.1"
  }
}
